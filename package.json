{
  "name": "traceai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @traceai/web dev",
    "dev:api": "pnpm --filter @traceai/api dev",
    "dev:mcp": "pnpm --filter @traceai/mcp dev",
    "typecheck": "pnpm -r run typecheck",
    "bootstrap": "pnpm --filter @traceai/api bootstrap"
  }
}
