# Server-side Aurora credentials (same website as local TraceAI)
AURORA_API_URL=https://aurora-api.joostvanleeuwaarden.com
AURORA_USER_TOKEN=
AURORA_WEBSITE_ID=cmsiyy8oy00quoc01zzam3t6p
AURORA_LOCALE=en-US

# LAN IP of this host (prod Pi or test laptop). Used by deploy scripts.
TRACEAI_LAN_HOST=192.168.1.91

# Allow browser EventSource from the public hostname + this host's LAN UI
TRACEAI_CORS_ORIGINS=https://traceai.joostvanleeuwaarden.com,http://192.168.1.91:3011

# Durable ticket-event store (SSE replay + cross-process fan-out).
# Compose mounts /data as a volume and sets TRACEAI_EVENTS_DB there; point
# every API worker at the SAME file. Override the poll interval if needed.
# TRACEAI_EVENTS_POLL_MS=750

# In-app notification bell (SQLite). Same volume as auth/events.
# TRACEAI_NOTIFICATIONS_DB=/data/traceai-notifications.sqlite

# Baked into the Next.js image at build time
NEXT_PUBLIC_CMS_API_URL=https://aurora-api.joostvanleeuwaarden.com
NEXT_PUBLIC_TRACEAI_EVENTS_URL=https://traceai.joostvanleeuwaarden.com/events

# Aurora public read key. Server-only and read at RUNTIME (TRA-81 renamed this
# from NEXT_PUBLIC_CMS_SITE_KEY; the prefix would inline it into the bundle).
CMS_SITE_KEY=

# Server-only (web container): New ticket form proxies to the TraceAI API
# Prefer the compose service name so the web container talks to the API on the Docker network.
TRACEAI_API_URL=http://api:3847
TRACEAI_TOKEN=

# Session cookie HMAC (web) AND signed human-identity headers (API+web).
# Set the SAME value on API and web containers.
TRACEAI_SESSION_SECRET=

# Optional. 1 = always Secure cookies, 0 = never. Unset = follow the request
# (X-Forwarded-Proto / URL). Needed because the image has NODE_ENV=production
# and browsers drop Secure cookies on http:// LAN UIs.
# TRACEAI_COOKIE_SECURE=0

# Shared secret so the web session proxy can leave human-gated stages
# (require_human_approval_on_exit). Set the SAME value on API and web.
# Agents/MCP must NOT receive this secret.
TRACEAI_HUMAN_PROXY_SECRET=
