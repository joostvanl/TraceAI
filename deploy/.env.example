# Server-side Aurora credentials (same website as local TraceAI)
AURORA_API_URL=https://aurora-api.joostvanleeuwaarden.com
AURORA_USER_TOKEN=
AURORA_WEBSITE_ID=cmsiyy8oy00quoc01zzam3t6p
AURORA_LOCALE=en-US

# Allow browser EventSource from the public hostname + LAN UI
TRACEAI_CORS_ORIGINS=https://traceai.joostvanleeuwaarden.com,http://192.168.1.91:3011

# Baked into the Next.js image at build time
NEXT_PUBLIC_CMS_API_URL=https://aurora-api.joostvanleeuwaarden.com
NEXT_PUBLIC_CMS_SITE_KEY=
NEXT_PUBLIC_TRACEAI_EVENTS_URL=https://traceai.joostvanleeuwaarden.com/events

# Server-only (web container): New ticket form proxies to the TraceAI API
# Prefer the compose service name so the web container talks to the API on the Docker network.
TRACEAI_API_URL=http://api:3847
TRACEAI_TOKEN=

# Server-only (web container): UI login for the New ticket form.
# One shared account; sessions are HttpOnly cookies signed with TRACEAI_SESSION_SECRET
# (falls back to the password, so rotating it invalidates open sessions).
TRACEAI_UI_USER=joost
TRACEAI_UI_PASSWORD=
TRACEAI_SESSION_SECRET=
